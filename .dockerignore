# Build context hygiene: keep VCS data, virtualenvs, local state, logs, credentials and review artifacts OUT of the image.
.git
.gitignore
.github
.review*
.venv
venv
.venv-*
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
*.egg-info
build
dist
.demo
.tools
*.duckdb
*.duckdb.wal
*.db
*.log
logs
# credentials / environment files (the example file is documentation only and not needed in the image)
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.tfstate
*.tfstate.*
*.tfvars
.terraform
**/.terraform
.aws
.netrc
.pypirc
id_rsa*
id_ed25519*
credentials*
# not needed at runtime
platform
docs
tests
scripts
Makefile
*.md
!README.md
