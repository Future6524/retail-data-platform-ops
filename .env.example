# EXAMPLE ONLY. Every value is a placeholder. The local demo and the test-suite need NO environment variables.
# Copy to `.env` (git-ignored) if you want to run something optional; never commit the real file.

# --- AWS scheduled task (retail_ops.task); on AWS these are set by the Terraform task definition ---
RETAIL_STATE_BUCKET=<your-state-bucket-name>
RETAIL_INPUT_SOURCE=s3
AWS_REGION=<your-region>
# Credentials are NOT configured here: the ECS task uses its IAM task role. Do not add access keys.

# --- optional Snowflake backend (not integration-tested) ---
SNOWFLAKE_ACCOUNT=<your-account-identifier>
SNOWFLAKE_USER=<your-user>
SNOWFLAKE_PASSWORD=<your password>
